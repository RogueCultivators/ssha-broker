[Unit]
Description=ssha MCP server for agents (streamable HTTP)
Documentation=https://github.com/yourorg/ssha
After=network.target

[Service]
Type=simple
User=ssha
Group=ssha
StateDirectory=ssha

# Tokens come from server.tokens in the config, whose values are read from the
# environment (value_env) or the config file. Without tokens this refuses to
# bind anything but loopback.
ExecStart=/usr/local/bin/ssha --config /etc/ssha/config.yaml mcp --http 127.0.0.1:8765

Restart=on-failure
RestartSec=3

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/ssha
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
